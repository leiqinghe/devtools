import { useState, useEffect } from "react";
import { Outlet, useNavigate, useLocation, Link } from "react-router-dom";
import { Layout, Dropdown, Breadcrumb, Typography, Input, theme, Popover, Drawer } from "antd";
import { HomeOutlined, ThunderboltOutlined, SearchOutlined, QrcodeOutlined, MenuOutlined } from "@ant-design/icons";
import type { MenuProps } from "antd";
import QRCodeLib from "qrcode";
import { toolGroups, allTools, getToolByPath, getCategoryName, renderIcon } from "../data/tools";

const { Header, Content, Footer } = Layout;

function matchSearch(text: string, keyword: string): boolean {
  return text.toLowerCase().includes(keyword.toLowerCase());
}

export default function MainLayout() {
  const navigate = useNavigate();
  const location = useLocation();
  const { token } = theme.useToken();
  const [searchOpen, setSearchOpen] = useState(false);
  const [searchText, setSearchText] = useState("");
  const [siteUrl, setSiteUrl] = useState("");
  const [qrDataUrl, setQrDataUrl] = useState("");
  const [mobileOpen, setMobileOpen] = useState(false);

  useEffect(() => {
    fetch("/site.config.json")
      .then((res) => res.json())
      .then((config) => {
        const url = config.siteUrl || window.location.origin;
        setSiteUrl(url);
        QRCodeLib.toDataURL(url, { width: 200, margin: 1 }).then(setQrDataUrl);
      })
      .catch(() => {
        const url = window.location.origin;
        setSiteUrl(url);
        QRCodeLib.toDataURL(url, { width: 200, margin: 1 }).then(setQrDataUrl);
      });
  }, []);

  const currentTool = getToolByPath(location.pathname);
  const categoryName = getCategoryName(location.pathname);
  const isHome = location.pathname === "/";

  useEffect(() => {
    const tool = getToolByPath(location.pathname);
    if (tool) {
      document.title = `${tool.title} - 在线免费 - DevTools`;
      const meta = document.querySelector('meta[name="description"]');
      if (meta) {
        meta.setAttribute("content", `${tool.title}，${tool.desc}，在线免费工具`);
      } else {
        const newMeta = document.createElement("meta");
        newMeta.name = "description";
        newMeta.content = `${tool.title}，${tool.desc}，在线免费工具`;
        document.head.appendChild(newMeta);
      }
    } else {
      document.title = "DevTools - 开发者在线工具集，免费在线工具";
      const meta = document.querySelector('meta[name="description"]');
      if (meta) {
        meta.setAttribute("content", "DevTools 开发者在线工具集，提供时间戳转换、二维码生成/解码、JSON格式化、颜色转换、图片格式转换等，免费在线使用");
      }
    }
  }, [location.pathname]);

  const filteredTools = searchText.trim()
    ? allTools.filter(
        (t) =>
          matchSearch(t.title, searchText.trim()) ||
          matchSearch(t.desc, searchText.trim())
      )
    : [];

  const handleMenuClick: MenuProps["onClick"] = ({ key }) => {
    navigate(key);
  };

  return (
    <Layout style={{ minHeight: "100vh", background: "#f7f8fa" }}>
      <Header
        style={{
          display: "flex",
          alignItems: "center",
          justifyContent: "space-between",
          background: "#fff",
          padding: "0 40px",
          height: 64,
          borderBottom: "1px solid #f0f0f0",
          boxShadow: "0 1px 4px rgba(0,0,0,0.04)",
          position: "sticky",
          top: 0,
          zIndex: 100,
        }}
      >
        <div
          style={{ display: "flex", alignItems: "center", gap: 10, cursor: "pointer", flexShrink: 0 }}
          onClick={() => navigate("/")}
        >
          <ThunderboltOutlined style={{ fontSize: 26, color: token.colorPrimary }} />
          <Typography.Title level={4} style={{ margin: 0, fontWeight: 700, letterSpacing: -0.5 }}>
            DevTools
          </Typography.Title>
        </div>

        <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
          <div style={{ display: "flex", gap: 4 }} className="desktop-nav">
            {toolGroups.map((group) => (
              <Dropdown
                key={group.name}
                menu={{
                  items: group.tools.map((tool) => ({
                    key: tool.path,
                    icon: renderIcon(tool.Icon, 16),
                    label: tool.title,
                  })),
                  onClick: handleMenuClick,
                }}
                trigger={["hover"]}
              >
                <span
                  style={{
                    padding: "6px 16px",
                    cursor: "pointer",
                    borderRadius: 6,
                    fontSize: 14,
                    color: "#333",
                    transition: "all 0.2s",
                    whiteSpace: "nowrap",
                  }}
                  className="nav-item"
                >
                  {group.name}
                </span>
              </Dropdown>
            ))}
          </div>

          <Dropdown
            open={searchOpen && searchText.trim() !== ""}
            onOpenChange={(open) => {
              if (!open) {
                setSearchOpen(false);
                setSearchText("");
              }
            }}
            menu={
              filteredTools.length > 0
                ? {
                    items: filteredTools.map((t) => ({
                      key: t.path,
                      icon: renderIcon(t.Icon, 16),
                      label: (
                        <div>
                          <div style={{ fontWeight: 500 }}>{t.title}</div>
                          <div style={{ fontSize: 12, color: "#999" }}>{t.desc}</div>
                        </div>
                      ),
                    })),
                    onClick: ({ key }) => {
                      navigate(key);
                      setSearchOpen(false);
                      setSearchText("");
                    },
                  }
                : undefined
            }
            trigger={["click"]}
          >
            <Input
              prefix={<SearchOutlined style={{ color: "#bbb" }} />}
              placeholder="搜索工具..."
              value={searchText}
              onChange={(e) => {
                setSearchText(e.target.value);
                setSearchOpen(true);
              }}
              onFocus={() => setSearchOpen(true)}
              onBlur={() => setTimeout(() => { setSearchOpen(false); setSearchText(""); }, 200)}
              style={{ width: 180, borderRadius: 8 }}
              size="small"
              allowClear
            />
          </Dropdown>

          <Popover
            content={
              <div style={{ textAlign: "center", padding: 4 }}>
                {qrDataUrl ? (
                  <img src={qrDataUrl} alt="手机扫码访问" style={{ width: 160, height: 160 }} />
                ) : (
                  <div style={{ width: 160, height: 160, background: "#f5f5f5", display: "flex", alignItems: "center", justifyContent: "center" }}>
                    <Typography.Text type="secondary">加载中...</Typography.Text>
                  </div>
                )}
                <Typography.Paragraph type="secondary" style={{ margin: "8px 0 0", fontSize: 12, wordBreak: "break-all" }}>
                  {siteUrl || "加载中..."}
                </Typography.Paragraph>
              </div>
            }
            title="手机扫码访问"
            trigger="hover"
          >
            <span
              style={{
                display: "inline-flex",
                alignItems: "center",
                justifyContent: "center",
                width: 32,
                height: 32,
                borderRadius: 6,
                cursor: "pointer",
                color: "#666",
                fontSize: 20,
                transition: "all 0.2s",
              }}
              className="nav-item"
            >
              <QrcodeOutlined />
            </span>
          </Popover>

          <span
            className="mobile-menu-btn"
            onClick={() => setMobileOpen(true)}
            style={{
              alignItems: "center",
              justifyContent: "center",
              width: 32,
              height: 32,
              borderRadius: 6,
              cursor: "pointer",
              color: "#666",
              fontSize: 20,
            }}
          >
            <MenuOutlined />
          </span>
        </div>
      </Header>

      <Drawer
        title="DevTools"
        placement="left"
        onClose={() => setMobileOpen(false)}
        open={mobileOpen}
        width={280}
      >
        <Input
          prefix={<SearchOutlined style={{ color: "#bbb" }} />}
          placeholder="搜索工具..."
          onChange={(e) => setSearchText(e.target.value)}
          onPressEnter={() => { setMobileOpen(false); }}
          allowClear
          style={{ marginBottom: 16, borderRadius: 8 }}
        />
        {toolGroups.map((group) => (
          <div key={group.name} style={{ marginBottom: 12 }}>
            <Typography.Text strong style={{ fontSize: 13, color: "#999", paddingLeft: 8 }}>
              {group.name}
            </Typography.Text>
            {group.tools.map((tool) => (
              <div
                key={tool.path}
                onClick={() => { navigate(tool.path); setMobileOpen(false); }}
                style={{
                  padding: "10px 12px",
                  margin: "2px 0",
                  borderRadius: 6,
                  cursor: "pointer",
                  display: "flex",
                  alignItems: "center",
                  gap: 10,
                  fontSize: 14,
                  color: location.pathname === tool.path ? "#1677ff" : "#333",
                  background: location.pathname === tool.path ? "#e6f4ff" : "transparent",
                }}
              >
                {renderIcon(tool.Icon, 18)}
                {tool.title}
              </div>
            ))}
          </div>
        ))}
      </Drawer>

      {!isHome && currentTool && (
        <div
          style={{
            maxWidth: 1200,
            margin: "0 auto",
            padding: "12px 40px",
            width: "100%",
          }}
        >
          <Breadcrumb
            items={[
              {
                title: (
                  <Link to="/" style={{ color: "#666" }}>
                    <HomeOutlined /> 首页
                  </Link>
                ),
              },
              ...(categoryName ? [{ title: <span style={{ color: "#999" }}>{categoryName}</span> }] : []),
              { title: <span style={{ color: "#333" }}>{currentTool.title}</span> },
            ]}
          />
        </div>
      )}

      <Content
        style={{
          padding: isHome ? "24px 40px" : "0 40px 24px",
          maxWidth: 1200,
          margin: "0 auto",
          width: "100%",
        }}
        className="main-content"
      >
        <Outlet />
      </Content>

      <Footer style={{ textAlign: "center", color: "#bbb", background: "transparent", fontSize: 13 }}>
        DevTools 开发者在线工具集 &copy; {new Date().getFullYear()}&nbsp;&nbsp;·&nbsp;&nbsp;打开即用，无需注册&nbsp;&nbsp;·&nbsp;&nbsp;所有数据本地处理，不上传服务器
      </Footer>
    </Layout>
  );
}
